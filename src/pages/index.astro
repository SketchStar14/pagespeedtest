---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import "../styles/style.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>PageSpeed</title>
	</head>
	<body>

		<Header />


		<form>
			<div id="input-container">
			  <input class="comment" type="text" placeholder="Enter a web page URL">

               <div class="button-container">
                  <button>
			        <span>Analyze</span>
			      </button>
			   </div>
		    </div>
	    </form>

        

		<section class="center-container">
			<div class="center">
				<h1> Make your web pages fast on all devices</h1>
				<p>Check out</p>

				<div class="l3">
				  <div class="t1">
					 <a href="//">What's new</a>
				  </div>

				  <div class="t2">
					 <a href="//">Documentation</a>
				  </div>

				  <div class="t3">
					 <a href="//">Learn more about Web Performance</a>
				  </div>
				</div>

			</div>

			<img src="//">


		</section>


		<div class="break"></div>
		<Footer />
	
	</body>
</html>
